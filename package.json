{
  "name": "lineup-prototype-03",
  "private": true,
  "description": "The ITP/IMA catalog walking skeleton. Built from the spec in docs/ — see docs/README.md.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "eslint . && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.docs.json",
    "db:generate": "drizzle-kit generate --config=drizzle.people.config.ts && drizzle-kit generate --config=drizzle.classes.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.people.config.ts && drizzle-kit migrate --config=drizzle.classes.config.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "check:protection": "tsx scripts/check-deployment-protection.ts"
  },
  "dependencies": {
    "@mantine/core": "^9.5.1",
    "@mantine/hooks": "^9.5.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "mantine-datatable": "^9.4.0",
    "next": "^16.3.0",
    "postgres": "^3.4.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "^17.2.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.3.0",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "xstate": "^5.32.5"
  }
}
